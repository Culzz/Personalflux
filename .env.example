APP_ENV=development
APP_NAME=PersonaFlux
API_V1_PREFIX=/api/v1

POSTGRES_USER=personalflux
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=personalflux

# Local backend (no compose): point at localhost.
# Compose overrides this with the db service hostname.
DATABASE_URL=postgresql+psycopg://personalflux:change-me-dev-only@localhost:5432/personalflux

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=http://localhost:5173
MODEL_ARTIFACT_DIR=./ml/artifacts
LOG_LEVEL=INFO

# How often each worker checks the database for a newly promoted model (seconds).
MODEL_POLL_SECONDS=10
# A rotated refresh token reused within this window is treated as a two-tab race.
REFRESH_REUSE_GRACE_SECONDS=10

# Database pool (per worker). Statement timeout protects the pool from a stuck query.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=15000

# Optional: a tarball the container fetches at boot when the artefact is not in
# the image (e.g. a release asset or a pre-signed object-store URL).
# MODEL_ARTIFACT_URL=

# Real affiliate catalogue (eBay Browse). Without these the importer refuses.
# Create an application key set at developer.ebay.com.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE_ID=EBAY_US
# AFFILIATE_CAMPAIGN_ID=

APP_ENV=development
APP_NAME=PersonaFlux
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://personalflux:your-password-here@localhost:5432/personalflux
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173
MODEL_ARTIFACT_DIR=../ml/artifacts
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true

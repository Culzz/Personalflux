# Files the Cloud Run source upload needs.

# Everything is uploaded except local development state. The trained model in
# model_artifacts/ must stay in the upload even though git ignores it, which is
# the reason this file exists rather than letting gitignore decide.
.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.env
.env.*
*.log
